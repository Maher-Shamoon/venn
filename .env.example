# Copy to services/api/.env for local runs. Never commit real values.
VENN_ENV=local
VENN_DATABASE_URL=postgresql+psycopg://venn:venn@localhost:5432/venn
VENN_REDIS_URL=redis://localhost:6379/0
VENN_CORS_ORIGINS=["http://localhost:5174"]
VENN_LOG_LEVEL=INFO
# Supabase (see docs/deployment/SUPABASE_SETUP.md)
VENN_JWKS_URL=
VENN_JWT_ISSUER=
VENN_JWT_SECRET=
